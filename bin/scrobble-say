#!/usr/bin/env bash
# scrobble-say shim — invokes the script via the project-local venv so the
# command works as a single word from anywhere.
#
# Safe to symlink from ~/.local/bin or /usr/local/bin: this script resolves
# the symlink chain to find its real location before locating the venv.
set -euo pipefail

# Canonical "resolve $SOURCE through symlinks" idiom.
SOURCE="${BASH_SOURCE[0]:-$0}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null && pwd)"

exec "$REPO/venv/bin/python3" "$REPO/scrobble_say.py" "$@"
